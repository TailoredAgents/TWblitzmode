+async def _send_campaign_background(campaign_id: int, tenant_id: int, test_mode: bool = False):
+    """Background task to send campaign"""
+    try:
+        stats = await email_service.send_campaign(
+            campaign_id=campaign_id,
+            tenant_id=tenant_id,
+            test_mode=test_mode
+        )
