+            event_type TEXT NOT NULL,
+            status TEXT NOT NULL,
+            http_status INTEGER,
+            response_body TEXT,
+            error_message TEXT,
+            retry_count INTEGER DEFAULT 0,
+            created_at TIMESTAMPTZ DEFAULT NOW()
+        )
+        """
+    )
+    conn.commit()
