+            <Skeleton className="h-4 w-24" />
+            <Skeleton className="h-3 w-20" />
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+};
+
+// Text Lines Skeleton
+interface TextSkeletonProps {
