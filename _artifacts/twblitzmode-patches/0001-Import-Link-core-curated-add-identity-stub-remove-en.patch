+
+# CORS Configuration - Secure defaults with production support
+def _parse_allowed_origins() -> list[str]:
+    """Derive the CORS origin allow-list from environment configuration."""
+    default_origins = {
+        "http://localhost:3000",
+        "http://localhost:3001",
+    }
+    configured_dashboard_origins = {
