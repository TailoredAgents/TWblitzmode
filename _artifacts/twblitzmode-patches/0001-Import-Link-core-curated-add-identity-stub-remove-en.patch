+    def _format_guardrail_message(
+        self,
+        session: SessionState,
+        capability: str,
+        *,
+        reason: str,
+        required_roles: Optional[Iterable[str]] = None,
+    ) -> str:
+        """Generate standardized guardrail messaging for blocked capabilities."""
