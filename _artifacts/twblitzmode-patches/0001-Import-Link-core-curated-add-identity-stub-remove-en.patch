+    WHERE constraint_schema = 'public';
+
+    -- Count tables
+    SELECT COUNT(*) INTO table_count
+    FROM information_schema.tables
+    WHERE table_schema = 'public';
+
+    -- Count RLS policies
+    SELECT COUNT(*) INTO policy_count
+    FROM pg_policies
+    WHERE schemaname = 'public';
