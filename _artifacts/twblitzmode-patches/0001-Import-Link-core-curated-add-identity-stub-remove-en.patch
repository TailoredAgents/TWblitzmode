+        'operation_name': operation_name,
+        'workflow_id': workflow_id,
+        'organization_id': organization_id,
+        **context_data
+    }
+
+    try:
+        yield context
+    except Exception as e:
+        await error_handler.handle_error(
+            e,
+            context=context,
+            service_name=service_name,
+            function_name=operation_name
+        )
+        raise
