+                )
+                health_status["logging_test"] = "passed" if test_event_id else "failed"
+            except Exception as e:
+                health_status["logging_test"] = "failed"
+                health_status["logging_error"] = str(e)
+                health_status["status"] = "degraded"
+
+            return health_status
