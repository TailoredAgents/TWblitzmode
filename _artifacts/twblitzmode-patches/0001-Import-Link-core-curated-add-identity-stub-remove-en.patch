+    def _is_provider_on_cooldown(self, provider: str) -> Tuple[bool, Optional[str]]:
+        """Check if provider is on cooldown due to errors"""
+        try:
+            with get_db() as conn:
+                cursor = conn.execute("""
+                    SELECT error_type, cooldown_until 
+                    FROM provider_cooldowns 
+                    WHERE provider = ? 
