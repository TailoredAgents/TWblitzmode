+        create_index_if_not_exists(cursor, "idx_linkedin_metrics_date", "linkedin_metrics", "created_at")
+        
+        # Create LinkedIn daily usage tracking
+        cursor.execute("""
+            CREATE TABLE IF NOT EXISTS linkedin_daily_usage (
