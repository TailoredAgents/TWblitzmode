+def rollback_email_migrations():
+    """Rollback email migrations if needed"""
+    conn = get_db()
+    cursor = conn.cursor()
+    
+    try:
+        # Drop tables in reverse order due to foreign keys
+        tables_to_drop = [
+            'linkedin_daily_usage',
+            'linkedin_metrics',
+            'linkedin_campaign_messages',
+            'linkedin_campaigns',
+            'email_costs',
