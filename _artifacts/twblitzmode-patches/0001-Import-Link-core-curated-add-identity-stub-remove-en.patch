+                    "errorMessage": run_info.get("errorMessage", ""),
+                    "exitCode": run_info.get("exitCode"),
+                    "finishedAt": run_info.get("finishedAt"),
+                    "stats": run_info.get("stats", {})
+                }
+                
+                # Try to get more specific error from stats
