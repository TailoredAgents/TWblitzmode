+
+    async def send_notification_email(self,
+                                    recipient_email: str,
+                                    subject: str,
+                                    html_content: str,
+                                    text_content: Optional[str] = None,
+                                    organization_id: Optional[int] = None) -> Dict[str, Any]:
+        """
+        Send notification email with caching and rate limiting
+        """
+        # Check rate limit if enabled
