+            )
+
+        except Exception as e:
+            logger.error(f"System health check failed: {e}")
+            return HealthCheck(
+                name="system",
+                status=HealthStatus.CRITICAL,
+                message=f"System health check failed: {str(e)}",
+                timestamp=datetime.now(timezone.utc),
