+            r"(?:ceo|chief executive|president|founder)\s+(?:of\s+)?[\w\s]+",
+            r"[\w\s]+\s+(?:company|corp|corporation|inc|llc)",
+            r"executives?\s+at\s+[\w\s]+",
+            r"leadership\s+(?:of|at)\s+[\w\s]+"
+        ]
