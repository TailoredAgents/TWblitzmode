+              {activeTab === 'api' && canManageSettings && renderApiSettings()}
+              {activeTab === 'cookie-jar' && renderCookieJarSettings()}
+            </div>
+          </div>
+        </div>
+      </GlassCard>
+    </div>
+  );
+}
