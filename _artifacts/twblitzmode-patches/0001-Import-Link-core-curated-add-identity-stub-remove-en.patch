+
+                # Check expiration
+                if row['expires_at'] and datetime.now(timezone.utc) > row['expires_at']:
+                    await self.delete_secret(name)
+                    return None
+
+                # Update access count
+                await conn.execute("""
+                    UPDATE security_credentials
+                    SET access_count = access_count + 1, last_accessed = $1
+                    WHERE name = $2
