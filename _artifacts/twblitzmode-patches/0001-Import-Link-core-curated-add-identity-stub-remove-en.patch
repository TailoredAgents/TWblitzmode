+    PRIMARY_MODEL: str = os.environ.get("PRIMARY_MODEL", "gpt-4.1")
+    OPENAI_MODEL: str = os.environ.get("OPENAI_MODEL", os.environ.get("PRIMARY_MODEL", "gpt-4.1"))
+    OPENAI_AGENTS_ENABLED: bool = False
