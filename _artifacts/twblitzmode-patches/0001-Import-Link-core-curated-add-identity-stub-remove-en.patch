+                    "expires_at": item.expires_at.isoformat() if item.expires_at else None,
+                    "is_active": item.is_active,
+                    "metadata": item.metadata,
+                    **self._derive_rotation_metadata(item, now=now),
+                }
+                for item in vault_items
+            ]
+
