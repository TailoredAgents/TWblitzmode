+                        session.pending_tool_execution = execution_result.execution_id
+
+                        return f"""🔧 **Tool Confirmation Required**
+
+{execution_result.confirmation_message}
+
+**Tool**: {top_suggestion['name']}
+**Action**: {top_suggestion['description']}
+
