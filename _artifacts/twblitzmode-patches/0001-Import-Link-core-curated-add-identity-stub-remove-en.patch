+-- ============================================================================
+-- PARTIAL INDEXES FOR PERFORMANCE
+-- ============================================================================
+
+-- Partial index for active prospects only
+CREATE INDEX IF NOT EXISTS idx_prospects_active ON prospects(organization_id, created_at)
