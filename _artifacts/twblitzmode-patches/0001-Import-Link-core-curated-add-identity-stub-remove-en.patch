+        """)
+        
+        conn.commit()
+        
+        return {
+            "status": "success", 
+            "message": "Migration completed successfully. Added unique constraint and indexes."
+        }
+        
+    except Exception as e:
+        error_msg = str(e)
+        if 'conn' in locals():
+            conn.rollback()
+        
+        # Provide helpful error messages
+        if "psycopg2" in error_msg or "PostgreSQL driver not available" in error_msg:
