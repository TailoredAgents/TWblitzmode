+def _split_display_name(full_name: str) -> tuple[str, Optional[str]]:
+    tokens = [segment for segment in (full_name or "").strip().split(" ") if segment]
+    if not tokens:
+        return "", None
+    if len(tokens) == 1:
+        return tokens[0], None
+    return tokens[0], " ".join(tokens[1:])
