+            WHERE id = %s
+        """, (message_id,))
+
+    def _update_campaign_stats(self, cursor, campaign_id: int, stats):
+        """Helper method for updating campaign statistics"""
+        from .shared_types import CampaignStatus
+        cursor.execute("""
+            UPDATE email_campaigns 
