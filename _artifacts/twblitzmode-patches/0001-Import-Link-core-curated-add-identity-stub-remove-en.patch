+def generate_webhook_signature(payload: str, secret: str) -> str:
+    """Generate HMAC SHA256 signature for webhook payload"""
+    return hmac.new(
+        secret.encode('utf-8'),
+        payload.encode('utf-8'),
+        hashlib.sha256
+    ).hexdigest()
