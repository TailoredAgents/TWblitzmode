+      expired: Number(entry.expired ?? 0),
+      expiringSoon: Number(entry.expiring_soon ?? 0),
+      stale: Number(entry.stale ?? 0),
+      rotationRecommended: Boolean(entry.rotation_recommended),
+      vaultItemIds: toStringArray(entry.vault_item_ids),
