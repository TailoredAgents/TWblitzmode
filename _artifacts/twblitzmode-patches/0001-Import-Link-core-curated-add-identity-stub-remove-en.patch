+                        FROM api_usage
+                        WHERE tenant_id = %s
+                        AND operation_type = %s
+                        AND timestamp >= %s
+                    """, (tenant_id, operation_type, current_hour))
+
+                    current_usage = cursor.fetchone()[0]
+
+                if (current_usage + count) <= limit:
