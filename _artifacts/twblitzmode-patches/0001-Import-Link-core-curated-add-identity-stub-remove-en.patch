+        if condition.startswith(">"):
+            return value > threshold
+        elif condition.startswith("<"):
+            return value < threshold
+        elif condition.startswith(">="):
+            return value >= threshold
+        elif condition.startswith("<="):
+            return value <= threshold
+        elif condition.startswith("=="):
+            return value == threshold
+        else:
+            return False
+
