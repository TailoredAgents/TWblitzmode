+                    status = $1, assigned_to = $2, approved_by = $3, approved_at = $4,
+                    rejection_reason = $5, escalation_reason = $6, metadata = $7
+                WHERE id = $8
+            """, request.status.value, request.assigned_to, request.approved_by,
