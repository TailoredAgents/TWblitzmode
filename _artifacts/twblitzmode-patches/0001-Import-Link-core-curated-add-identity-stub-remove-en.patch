+            
+        except Exception as e:
+            logger.error(f"Dual approach failed: {e}")
+            return {
+                "providers_used": [],
+                "primary_provider": "none", 
+                "total_mutuals": 0,
+                "error": str(e)
+            }
+    
+        """Try Apify first, fallback to PhantomBuster if needed"""
+        try:
+            logger.info("Running sequential approach: Apify -> PhantomBuster fallback")
