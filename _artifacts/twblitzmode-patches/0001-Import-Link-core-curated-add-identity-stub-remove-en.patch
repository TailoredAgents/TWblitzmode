+                name="disk",
+                status=status,
+                message=message,
+                timestamp=datetime.now(timezone.utc),
+                response_time_ms=(time.time() - start_time) * 1000,
+                metadata={
+                    "total_gb": disk_usage.total / (1024**3),
+                    "used_gb": disk_usage.used / (1024**3),
+                    "free_gb": disk_usage.free / (1024**3),
