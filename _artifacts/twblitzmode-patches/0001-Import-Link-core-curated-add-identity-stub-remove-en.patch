+// Standardized error states for production-ready error handling
+
+'use client';
+
+import React from 'react';
+import {
+  AlertCircle,
+  WifiOff,
+  Shield,
+  RefreshCw,
+  XCircle,
+  AlertTriangle,
+  FileX,
+  Database,
+  Server,
