+                    confidence=0.85,
+                    context=f"{context}:{label}",
+                    timestamp=datetime.now(timezone.utc)
+                ))
+                return redacted_text
+
+            filtered_text = compiled.sub(replacer, filtered_text)
+
+        return filtered_text, violations
