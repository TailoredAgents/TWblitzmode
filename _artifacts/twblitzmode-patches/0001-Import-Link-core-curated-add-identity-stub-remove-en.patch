+        INSERT INTO webhook_delivery_attempts (
+            webhook_id, event_type, status, http_status,
+            response_body, error_message, retry_count, created_at
+        )
+        VALUES (%s, %s, %s, %s, %s, %s, %s, NOW())
+        """,
+        (
+            webhook_id,
+            event_type,
+            status,
+            http_status,
+            response_body,
+            error_message,
+            retry_count,
+        ),
+    )
+    conn.commit()
+    cursor.close()
+
+
+if ENABLE_E2E_WEBHOOK_TRIGGER:
