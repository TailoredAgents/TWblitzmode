+_COLUMN_CACHE: Dict[tuple[int, str, str, str], bool] = {}
+_INSERT_REGEX = re.compile(
+    r"INSERT\s+INTO\s+(?P<table>(?:\"[^\"]+\"|\w+)(?:\.(?:\"[^\"]+\"|\w+))?)\s*(?:\((?P<columns>[^)]+)\))?",
+    re.IGNORECASE,
