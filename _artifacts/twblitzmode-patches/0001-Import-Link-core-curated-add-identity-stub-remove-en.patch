+                                className={cn(
+                                  'px-3 py-1 rounded-full text-xs font-medium transition-colors',
+                                  filters.industries?.includes(industry)
+                                    ? 'bg-primary text-primary-foreground'
+                                    : 'bg-muted text-muted-foreground hover:bg-muted/80'
+                                )}
