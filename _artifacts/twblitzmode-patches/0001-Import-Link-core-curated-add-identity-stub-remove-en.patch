+    },
+    {
+      key: '8',
+      metaKey: true,
+      action: () => onViewChange('settings'),
+      description: 'Go to Settings',
+      category: 'Navigation',
+    },
+
+    // Theme shortcuts
+    {
+      key: 't',
+      metaKey: true,
