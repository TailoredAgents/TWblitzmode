+    *,
+    webhook_id: int,
+    event_type: str,
+    status: str,
+    http_status: Optional[int],
+    response_body: Optional[str],
+    error_message: Optional[str],
+    retry_count: int = 0,
+) -> None:
+    cursor = conn.cursor()
+    cursor.execute(
