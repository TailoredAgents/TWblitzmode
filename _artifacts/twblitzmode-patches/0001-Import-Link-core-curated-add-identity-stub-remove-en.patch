+            self.active_agents[agent_id] = {
+                "agent_id": agent_id,
+                "start_time": datetime.now(timezone.utc),
+                "last_activity": datetime.now(timezone.utc),
+                "events_count": 0,
+                "status": "unknown",
+                "current_task": None,
+                "error_count": 0
+            }
