{
  "name": "tallwave-dashboard",
  "version": "2.1.0",
  "description": "Tallwave warm-introduction workspace with enterprise guardrails",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint src",
    "type-check": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:api": "jest src/__tests__/api",
    "test:unit": "jest --testPathIgnorePatterns=api",
    "test:e2e": "node scripts/run-playwright.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:dev-e2e": "playwright test --config=playwright.dev.config.ts",
    "test:all": "npm run test:unit && npm run test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "visual:test": "storybook test --watch=false",
    "visual:upload": "chromatic --exit-zero-on-changes",
    "accessibility": "axe http://localhost:3000 --exit",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:ci": "cypress run --browser chrome --headless",
    "perf:lighthouse": "lhci autorun",
    "perf:load-test": "node performance/load-test.js",
    "perf:bundle-analyze": "ANALYZE=true npm run build",
    "security:scan": "node security/security-scan.js",
    "security:audit": "node security/run-audit-ci.js",
    "security:lint": "eslint src --max-warnings=0",
    "db:test-schema": "jest database/schema-validation.test.ts",
    "db:test-migration": "node database/migration-test.js",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "generate:api": "openapi-typescript ../build/openapi.json --output src/types/api-contracts.ts",
    "test:e2e:cypress": "cypress run",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright npx playwright install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.344.0",
    "next": "^14.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.52.0",
    "recharts": "^3.2.1",
    "socket.io-client": "^4.7.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.0",
    "@axe-core/playwright": "^4.11.0",
    "@cypress/code-coverage": "^3.14.7",
    "@playwright/test": "^1.40.0",
    "@storybook/addon-a11y": "8.4.7",
    "@storybook/addon-essentials": "8.4.7",
    "@storybook/nextjs": "8.4.7",
    "@storybook/test": "8.4.7",
    "@swc/jest": "^0.2.36",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/cypress": "^0.1.6",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.4.21",
    "axios-mock-adapter": "^1.21.2",
    "chromatic": "^10.5.0",
    "cypress": "^13.6.2",
    "cypress-real-events": "^1.15.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "eslint-plugin-security": "^1.7.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "lint-staged": "^15.5.2",
    "openapi-typescript": "^6.7.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "semgrep": "^0.0.1",
    "storybook": "^8.4.7",
    "supertest": "^7.1.4",
    "typescript": "^5.4.5",
    "webpack": "^5.95.0"
  },
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
